{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "outDir": "./types",
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/stringalong.js",
    "index.js",
    "bin/cli.js"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "**/*.d.ts"
  ]
}
